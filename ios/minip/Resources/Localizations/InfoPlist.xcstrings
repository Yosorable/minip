{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird zum Scannen von QR-Codes und zum Aufnehmen von Fotos verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan QR codes and take photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para escanear códigos QR y tomar fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert à scanner des codes QR et à prendre des photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera viene usata per scansionare i codici QR e scattare foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用してQRコードのスキャンや写真の撮影を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라는 QR 코드 스캔과 사진 촬영에 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada para escanear códigos QR e tirar fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера используется для сканирования QR-кодов и съёмки фотографий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于扫描二维码和拍摄照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機用於掃描 QR 碼和拍攝照片。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID wird verwendet, um die App schnell und sicher zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID is used to quickly and securely unlock the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID se usa para desbloquear la app de forma rápida y segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID permet de déverrouiller l’app rapidement et en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID viene usato per sbloccare l’app in modo rapido e sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDを使用してアプリをすばやく安全にロック解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID는 앱을 빠르고 안전하게 잠금 해제하는 데 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Face ID é usado para desbloquear o app de forma rápida e segura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID используется для быстрой и безопасной разблокировки приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 用于快速、安全地解锁应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 用於快速且安全地解鎖 App。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit deinem Computer, um Mini-Apps mit Live-Aktualisierungen zu entwickeln und App-Pakete zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your computer to develop mini apps with live updates and install app packages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a tu computadora para desarrollar miniapps con actualizaciones en tiempo real e instalar paquetes de apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à votre ordinateur pour développer des mini-apps avec des mises à jour en direct et installer des paquets d’apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti al computer per sviluppare mini app con aggiornamenti in tempo reale e installare pacchetti di app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピュータに接続して、リアルタイム更新を使ったミニアプリの開発やアプリパッケージのインストールを行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에 연결하여 실시간 업데이트로 미니 앱을 개발하고 앱 패키지를 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se ao computador para desenvolver mini apps com atualizações em tempo real e instalar pacotes de apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к компьютеру для разработки мини-приложений с обновлением в реальном времени и установки пакетов приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接电脑，以实时更新的方式开发小程序并安装应用包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接電腦，以即時更新的方式開發小程式並安裝 App 套件。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wird zum Aufnehmen von Audio in Videos oder Notizen verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used to record audio in videos or notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se usa para grabar audio en videos o notas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le microphone sert à enregistrer de l’audio dans les vidéos ou les notes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono viene usato per registrare l’audio nei video o nelle note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを使用して動画やメモの音声を録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크는 동영상이나 메모의 오디오 녹음에 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone é usado para gravar áudio em vídeos ou notas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон используется для записи звука в видео или заметках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风用于录制视频或笔记中的音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風用於錄製影片或筆記中的音訊。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff zum Sichern von Fotos erlaubt der App, erstellte oder heruntergeladene Bilder zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to save photos allows the app to store images you create or download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso para guardar fotos permite a la app almacenar las imágenes que creas o descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’enregistrer des photos permet à l’app de sauvegarder les images que vous créez ou téléchargez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso per salvare le foto consente all’app di memorizzare le immagini che crei o scarichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の保存を許可すると、作成またはダウンロードした画像を保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 저장 권한을 허용하면 앱에서 만들거나 다운로드한 이미지를 저장할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão para salvar fotos permite que o app armazene imagens que você cria ou baixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на сохранение фото позволяет приложению сохранять созданные или загруженные вами изображения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许保存照片后，应用可以存储你创建或下载的图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許儲存照片後，App 即可儲存你建立或下載的影像。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Fotos wird benötigt, um Bilder zum Bearbeiten, Teilen oder Scannen von QR-Codes auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to your photo library is used to select pictures for editing, sharing, or scanning QR codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos se usa para seleccionar imágenes para editar, compartir o escanear códigos QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux photos permet de sélectionner des images à modifier, à partager ou dont scanner les codes QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla libreria foto viene usato per selezionare le immagini da modificare, condividere o usare per scansionare i codici QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリから、編集、共有、QRコードのスキャンに使用する画像を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함 접근은 편집, 공유 또는 QR 코드 스캔에 사용할 사진을 선택하는 데 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à biblioteca de fotos é usado para selecionar imagens para editar, compartilhar ou escanear códigos QR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к медиатеке используется для выбора изображений для редактирования, отправки или сканирования QR-кодов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问照片用于选择图像进行编辑、共享或扫描二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取用照片用於選擇影像進行編輯、分享或掃描 QR 碼。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
