    "Tap the %@ button in the upper right corner to create new files or folders." : {
      "comment" : "The placeholder is the inline add button icon.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die %@-Taste oben rechts, um neue Dateien oder Ordner zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the %@ button in the upper right corner to create new files or folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón %@ en la esquina superior derecha para crear nuevos archivos o carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le bouton %@ en haut à droite pour créer des fichiers ou des dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante %@ in alto a destra per creare nuovi file o cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の %@ ボタンをタップしてファイルやフォルダを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 상단의 %@ 버튼을 눌러 파일이나 폴더를 만드세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
