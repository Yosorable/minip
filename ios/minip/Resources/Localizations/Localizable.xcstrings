    "Keep the server running, connect your phone and computer to the same network, and allow Minip to access the local network in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Server laufen, verbinde Telefon und Computer mit demselben Netzwerk und erlaube Minip in den Einstellungen den Zugriff auf das lokale Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the server running, connect your phone and computer to the same network, and allow Minip to access the local network in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el servidor en ejecución, conecta el teléfono y el ordenador a la misma red y permite que Minip acceda a la red local en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le serveur en marche, connectez le téléphone et l’ordinateur au même réseau et autorisez Minip à accéder au réseau local dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il server in esecuzione, collega telefono e computer alla stessa rete e consenti a Minip di accedere alla rete locale in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーを起動したまま、スマートフォンとコンピュータを同じネットワークに接続し、設定で Minip のローカルネットワークへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버를 실행한 상태로 휴대폰과 컴퓨터를 같은 네트워크에 연결하고, 설정에서 Minip의 로컬 네트워크 접근을 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o servidor em execução, conecte o celular e o computador à mesma rede e permita que o Minip acesse a rede local nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте сервер запущенным, подключите телефон и компьютер к одной сети и разрешите Minip доступ к локальной сети в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持服务器运行，将手机和电脑连接到同一网络，并在系统设置中允许 Minip 访问本地网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請保持伺服器執行，將手機和電腦連接到同一網路，並在系統設定中允許 Minip 存取區域網路。"
          }
        }
      }
    },
