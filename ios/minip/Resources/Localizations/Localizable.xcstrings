    "Use this file name if the server does not provide one. Leave it empty to use default.zip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Dateiname wird verwendet, wenn der Server keinen angibt. Lass das Feld leer, um default.zip zu verwenden."
