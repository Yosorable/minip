    "Downloaded files are saved in the .tmp folder in Documents. Delete them manually when no longer needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Dateien werden im Ordner .tmp unter Documents gespeichert. Lösche sie manuell, wenn du sie nicht mehr benötigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded files are saved in the .tmp folder in Documents. Delete them manually when no longer needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos descargados se guardan en la carpeta .tmp de Documents. Elimínalos manualmente cuando ya no los necesites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers téléchargés sont enregistrés dans le dossier .tmp de Documents. Supprimez-les manuellement lorsque vous n’en avez plus besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file scaricati vengono salvati nella cartella .tmp in Documents. Eliminali manualmente quando non sono più necessari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
