    "The file server will automatically shut down if you leave this page, the app goes to the background, or your device's screen turns off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dateiserver wird automatisch beendet, wenn du diese Seite verlässt, die App in den Hintergrund wechselt oder der Bildschirm ausgeschaltet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file server will automatically shut down if you leave this page, the app goes to the background, or your device's screen turns off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de archivos se cerrará automáticamente si sales de esta página, la app pasa a segundo plano o la pantalla se apaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur de fichiers s'arrêtera automatiquement si vous quittez cette page, si l'application passe en arrière-plan ou si l'écran s'éteint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di file si arresterà automaticamente se lasci questa pagina, l'app va in background o lo schermo si spegne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このページから離れたり、アプリがバックグラウンドに移行したり、画面がオフになると、ファイルサーバーは自動的に停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 페이지를 떠나거나, 앱이 백그라운드로 전환되거나, 화면이 꺼지면 파일 서버가 자동으로 종료됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de arquivos será encerrado automaticamente se você sair desta página, o app entrar em segundo plano ou a tela do dispositivo se apagar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файловый сервер автоматически остановится, если вы покинете эту страницу, приложение перейдёт в фоновый режим или экран выключится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你离开此页面、应用进入后台或设备屏幕关闭，文件服务器将自动关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你離開此頁面、應用程式進入背景或裝置螢幕關閉，檔案伺服器將自動關閉。"
          }
        }
      }
    },
