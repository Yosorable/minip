    "2. On the same network, use another device’s web browser to open the displayed URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Öffne im gleichen Netzwerk die angezeigte URL im Browser eines anderen Geräts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. On the same network, use another device’s web browser to open the displayed URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. En la misma red, abre la URL mostrada en el navegador de otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Sur le même réseau, ouvrez l'URL affichée dans le navigateur d'un autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Sulla stessa rete, apri l'URL visualizzato nel browser di un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 同じネットワーク上の別のデバイスのブラウザで表示されたURLを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 같은 네트워크에서 다른 기기의 브라우저로 표시된 URL을 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Na mesma rede, use o navegador de outro dispositivo para abrir a URL exibida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. В той же сети откройте отображаемый URL в браузере другого устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 在同一网络中，使用其他设备的浏览器打开显示的URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 在同一網路中，使用其他裝置的瀏覽器開啟顯示的URL。"
          }
        }
      }
    },
