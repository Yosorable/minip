{
  "name": "vite-plugin-minip",
  "version": "1.0.1",
  "description": "Develop Vite apps inside Minip with native APIs and hot updates, then package and install by QR code",
  "type": "module",
  "license": "MIT",
  "author": "yosorable",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yosorable/minip",
    "directory": "packages/vite-plugin-minip"
  },
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yazl": "^3.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "keywords": ["vite", "vite-plugin", "minip"]
}
